{
  "name": "pivotvault-backend",
  "version": "4.0.0",
  "description": "PivotVault Backend — AI-powered startup failure intelligence platform",
  "main": "src/index.js",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "build": "prisma generate --schema=prisma/schema.prisma",
    "prisma:generate": "prisma generate --schema=prisma/schema.prisma",
    "prisma:migrate": "prisma migrate dev --schema=prisma/schema.prisma",
    "prisma:push": "prisma db push --schema=prisma/schema.prisma",
    "prisma:seed": "node prisma/seed.js",
    "prisma:seed:json": "node prisma/seedFromJson.js",
    "prisma:validate": "prisma validate --schema=prisma/schema.prisma",
    "pipeline:start": "node src/pipeline/index.js",
    "ingest:direct": "node src/pipeline/directIngest.js",
    "test:scrapers": "node test/scraper.test.js",
    "test:contract": "node test/handoff-contract.test.js"
  },
  "keywords": [
    "startup-failure",
    "rag",
    "intelligence",
    "bullmq",
    "pgvector"
  ],
  "author": "PivotVault Team",
  "license": "MIT",
  "dependencies": {
    "@prisma/client": "^6.4.1",
    "axios": "^1.8.1",
    "bullmq": "^5.41.6",
    "cheerio": "^1.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.5.0",
    "pg": "^8.23.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "nodemon": "^3.1.9",
    "prisma": "^6.4.1"
  }
}
